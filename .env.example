# Configuracoes do Flask
FLASK_DEBUG=false

# Banco MySQL local (formato: mysql+pymysql://usuario:senha@host:porta/banco)
DATABASE_URL=mysql+pymysql://usuario:SENHA_CODIFICADA@127.0.0.1:3306/sptrans_dev?charset=utf8mb4
# Base separada, usada somente pela verificação/testes MySQL explícitos.
TEST_DATABASE_URL=mysql+pymysql://usuario:SENHA_CODIFICADA@127.0.0.1:3306/sptrans_test?charset=utf8mb4
# Aiven: substituir host/porta/usuários nas duas URLs e informar o CA baixado.
# Com CA preenchido, a aplicação verifica certificado e hostname do servidor.
MYSQL_SSL_CA=

# API Olho Vivo
SPTRANS_API_URL=https://api.olhovivo.sptrans.com.br/v2.1
GTFS_SOURCE_URL=
SPTRANS_TOKEN=

# Intervalo do processo coletor (15 a 60 segundos; padrão: 30)
GPS_COLLECTION_INTERVAL_SECONDS=

