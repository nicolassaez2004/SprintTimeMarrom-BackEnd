# Configuracoes do Flask
FLASK_DEBUG=false

# Banco MySQL local (formato: mysql+pymysql://usuario:senha@host:porta/banco)
DATABASE_URL=mysql+pymysql://usuario:SENHA_CODIFICADA@127.0.0.1:3306/sptrans_dev?charset=utf8mb4
# Base separada, usada somente pela verificação/testes MySQL explícitos.
TEST_DATABASE_URL=mysql+pymysql://usuario:SENHA_CODIFICADA@127.0.0.1:3306/sptrans_test?charset=utf8mb4
# Aiven: substituir host/porta/usuários nas duas URLs e informar o CA baixado.
# Com CA preenchido, a aplicação verifica certificado e hostname do servidor.
MYSQL_SSL_CA=
# GeoJSON WGS84 do limite municipal de São Paulo. Não usar retângulo aproximado.
# Baixar com: python -m app.correspondencia baixar-limite
MUNICIPIO_GEOJSON=

# API Olho Vivo
SPTRANS_API_URL=https://api.olhovivo.sptrans.com.br/v2.1
GTFS_SOURCE_URL=
# Diretório dos ZIPs GTFS; vazio usa instance/gtfs. Para vários processos/hosts
# consumidores, configurar um volume compartilhado acessível a todos eles.
GTFS_STORAGE_DIR=
# Log JSONL do processo de tarefas; vazio usa instance/logs/gtfs-tarefas.jsonl.
GTFS_TASK_LOG_FILE=
# JSONs brutos de programação oficial; vazio usa instance/programacao.
PROGRAMACAO_STORAGE_DIR=
# PDFs originais de documentos oficiais (US05); vazio usa instance/documentos.
DOCUMENTOS_STORAGE_DIR=
# Parquets diários dos brutos (US09); vazio usa instance/exportacoes.
EXPORTACOES_DIR=
SPTRANS_TOKEN=

# Intervalo do processo coletor (15 a 60 segundos; padrão: 30)
GPS_COLLECTION_INTERVAL_SECONDS=

# Checkpoint e caixa interna de alertas. Diretório persistente do worker,
# preservado nos reinícios; vazio usa instance/coleta/<identidade-do-banco>.
COLETA_STATE_DIR=

# Canal dos alertas de 10 min e de recuperação (webhook Discord/Slack/Teams).
# Segredo: não versionar. Vazio mantém só a caixa interna.
ALERTA_WEBHOOK_URL=

# US32: destino NOVO local marrom_restore_<identificador>. Nunca Aiven/dev/test.
# Necessário só para quem executa ensaios de recuperação (Matheus).
RESTORE_DATABASE_URL=

# US11: redes/IPs dos proxies que realmente se conectam à API. Vazio = nenhum.
# Exemplo apenas para um proxy local: 127.0.0.1/32,::1/128. Nunca usar /0.
INDICADORES_TRUSTED_PROXY_CIDRS=

